# DPC NEXUS backend (server-side) — NEVER use VITE_ prefix here.
# These values are SECRET and must never be bundled to the browser.

# HTTP
PORT=8787

# --- WordPress / WooCommerce (server-side bridge) ---
# Same site as the storefront; credentials stay on the server here.
WOOCOMMERCE_URL=https://dreampcbuild.com
WOOCOMMERCE_CONSUMER_KEY=ck_84925adbe0e0d8cfb85bc2180bec25a9b4c25b04
WOOCOMMERCE_CONSUMER_SECRET=cs_1a399de7f2b5c6ad05dc8179c278173654b72654

# --- Auth ---
# Secret used to sign HS256 JWTs issued by POST /api/v1/auth/login.
# Generate one: openssl rand -hex 32
JWT_SECRET=change-me

# --- Media upload (POST /api/v1/media) ---
# A WordPress APPLICATION PASSWORD for a user with upload permission (your
# owner/admin account), for the backend to push images into the WP media library.
# Create it: WP admin → Users → Profile → Application Passwords → "DPC backend".
# WP_MEDIA_USERNAME=jeo
# WP_MEDIA_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Supabase (future; see docs/DPC-NEXUS-SUPABASE-DATABASE-ARCHITECTURE.md) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=