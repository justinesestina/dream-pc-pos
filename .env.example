# Backend API base URL (no trailing slash).
# Local dev defaults to http://localhost:8787 if this is omitted.
# Production: set this to your deployed Hono API, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:8787

# DPC POS Connector (WordPress plugin) — enables the new auth flow.
# Set to the WordPress site root or the full REST base. Leave EMPTY to keep
# using the Hono backend + WordPress application-password flow.
#   VITE_DPC_API_URL=https://dreampcbuild.com
#   VITE_DPC_API_URL=https://dreampcbuild.com/wp-json/dpc/v1
VITE_DPC_API_URL=

# WooCommerce REST API Configuration
# Get your API keys from: WooCommerce → Settings → Advanced → REST API
# Create keys with Read/Write permissions for full functionality
# NOTE: these variables are bundled into the browser. Prefer server-side
# credentials (backend/.env or the DPC POS Connector integrations screen).

# Your WooCommerce store URL (without trailing slash)
VITE_WOOCOMMERCE_URL=https://your-store.com/

# WooCommerce Consumer Key (starts with ck_)
VITE_WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WooCommerce Consumer Secret (starts with cs_)
VITE_WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
